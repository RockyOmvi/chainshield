# =============================================================================
# ChainShield Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=chainshield
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://chainshield:chainshield@localhost:5432/chainshield
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Redis (Cache + Queue)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
REDIS_RATE_LIMIT_PREFIX=rate:

# -----------------------------------------------------------------------------
# Blockchain Providers (Multi-provider failover)
# -----------------------------------------------------------------------------
# Primary: Alchemy (recommended)
ALCHEMY_API_KEY=your-alchemy-api-key
ALCHEMY_NETWORK=eth-mainnet

# Secondary: Infura
INFURA_API_KEY=your-infura-api-key
INFURA_NETWORK=mainnet

# Tertiary: Public RPC (fallback)
PUBLIC_RPC_URL=https://eth.llamarpc.com

# Provider settings
BLOCKCHAIN_TIMEOUT=30
BLOCKCHAIN_MAX_RETRIES=5
BLOCKCHAIN_RETRY_DELAY=1.0

# -----------------------------------------------------------------------------
# AI Providers (Fallback chain)
# -----------------------------------------------------------------------------
# Primary: OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.3

# Secondary: Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Tertiary: Ollama (local, free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# AI settings
AI_CACHE_TTL=3600
AI_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Endpoint-specific limits (requests per hour)
RATE_LIMIT_WALLET_ANALYZE=100
RATE_LIMIT_TX_ANALYZE=200
RATE_LIMIT_AI_EXPLAIN=50

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Keys
API_KEY_HEADER=X-API-Key
API_KEY_PREFIX=cs_

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Circuit Breaker
# -----------------------------------------------------------------------------
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30
CIRCUIT_BREAKER_HALF_OPEN_REQUESTS=2

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/chainshield.log

# -----------------------------------------------------------------------------
# Risk Engine
# -----------------------------------------------------------------------------
RISK_MODEL_PATH=app/services/risk/models/risk_model.pkl
RISK_SCORE_CACHE_TTL=1800
RISK_HIGH_THRESHOLD=70
RISK_MEDIUM_THRESHOLD=40

# -----------------------------------------------------------------------------
# Data Retention
# -----------------------------------------------------------------------------
DATA_RETENTION_HOT_DAYS=90
DATA_RETENTION_ARCHIVE_ENABLED=true
DATA_ARCHIVE_S3_BUCKET=chainshield-archive

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_AI_EXPLANATIONS=true
FEATURE_GRAPH_ANALYSIS=true
FEATURE_REAL_TIME_ALERTS=true

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=
