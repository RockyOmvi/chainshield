# Staging Environment Variables
# Copy to .env.staging and fill in real values

# =============================================================================
# REQUIRED - Must be set before deployment
# =============================================================================

# Database
POSTGRES_USER=chainshield
POSTGRES_PASSWORD=CHANGE_ME_generate_strong_password
POSTGRES_DB=chainshield_staging

# Security
JWT_SECRET_KEY=CHANGE_ME_generate_64_char_hex_string

# =============================================================================
# Optional - Have sensible defaults
# =============================================================================

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=["https://staging.chainshield.io","http://localhost:3000"]

# Email (if using email features)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=noreply@chainshield.io

# External APIs (optional - for enhanced data)
ETHERSCAN_API_KEY=
DUNE_API_KEY=
