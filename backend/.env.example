# =============================================================================
# ChainShield Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=chainshield
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Security (REQUIRED - Generate secure values!)
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_64_char_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Key prefix (appears in generated keys)
API_KEY_PREFIX=cs_

# -----------------------------------------------------------------------------
# Database (REQUIRED)
# -----------------------------------------------------------------------------
# PostgreSQL connection URL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chainshield

# Connection pool settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# Redis (REQUIRED for rate limiting and caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# -----------------------------------------------------------------------------
# CORS Settings
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=https://chainshield.io,https://app.chainshield.io
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Blockchain APIs (Optional - for enhanced data)
# -----------------------------------------------------------------------------
# Etherscan - Get free key at https://etherscan.io/apis
ETHERSCAN_API_KEY=

# BlockCypher - Get free key at https://www.blockcypher.com/
BLOCKCYPHER_TOKEN=

# Dune Analytics - Get free key at https://dune.com/
DUNE_API_KEY=

# -----------------------------------------------------------------------------
# Email (Required for user notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM=noreply@chainshield.io
SMTP_FROM_NAME=ChainShield

# SendGrid API (for transactional emails)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Frontend URL (for email links)
FRONTEND_URL=https://app.chainshield.io

# -----------------------------------------------------------------------------
# Observability (Optional)
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=chainshield
OTEL_EXPORTER_ENDPOINT=http://localhost:4317

SENTRY_DSN=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_SIGNUP=true
ENABLE_BILLING=false
REQUIRE_EMAIL_VERIFICATION=true

# -----------------------------------------------------------------------------
# Billing/Quotas (if ENABLE_BILLING=true)
# -----------------------------------------------------------------------------
# Stripe API keys
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Initial admin email (created on first run)
ADMIN_EMAIL=admin@chainshield.io
ADMIN_PASSWORD=CHANGE_ME_use_strong_password
